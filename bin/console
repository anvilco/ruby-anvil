#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "anvil"

# An Anvil client is waiting as `anvil` when ANVIL_API_KEY is set. Point it at
# another environment with ANVIL_BASE_URL.
if ENV["ANVIL_API_KEY"]
  anvil = Anvil::Client.new(
    api_key: ENV.fetch("ANVIL_API_KEY"),
    base_url: ENV.fetch("ANVIL_BASE_URL", Anvil::Client::DEFAULT_BASE_URL)
  )
  puts "`anvil` is an Anvil::Client for #{anvil.base_url}"
end

require "irb"
IRB.start(__FILE__)
